{
  "name": "Family Stream Relay",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "forwardPorts": [
    8888
  ],
  "portsAttributes": {
    "8888": {
      "label": "Family Stream HLS Relay",
      "onAutoForward": "silent",
      "visibility": "public"
    }
  },
  "postStartCommand": "nohup /usr/local/bin/mediamtx /workspaces/family-stream-relay/mediamtx.yml > /workspaces/family-stream-relay/mediamtx.log 2>&1 &"
}